rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==================== USER RULES ====================
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ==================== EXPERIENCES RULES ====================
    match /experiences/{expId} {
      allow read: if true; 
      // Must be logged in, payload userId must match, and strict data structure validated
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.author is string
        && request.resource.data.category is string
        && request.resource.data.duration is string
        && request.resource.data.year is string
        && request.resource.data.keys().hasAll(['userId', 'title', 'author', 'category', 'duration', 'year', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'title', 'author', 'category', 'goal', 'origin', 'destination', 'duration', 'cost', 'year', 'quote', 'whatWorked', 'whatDidnt', 'createdAt', 'views']);
      // Only the author can delete
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Author can update everything, anyone can update just the views field
      allow update: if (request.auth != null && resource.data.userId == request.auth.uid) || 
                       (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
    }

    // ==================== QUESTIONS RULES ====================
    match /questions/{questionId} {
      allow read: if true;
      // Must be logged in to ask, and askerId must match their auth uid
      allow create: if request.auth != null && request.resource.data.askerId == request.auth.uid;
      // Allow the asker to update/delete their own question OR allow the experience author to reply to it
      allow update: if request.auth != null && (
        resource.data.askerId == request.auth.uid ||
        get(/databases/$(database)/documents/experiences/$(resource.data.experienceId)).data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.askerId == request.auth.uid;
    }

    // ==================== FEEDBACK RULES ====================
    match /feedback/{feedbackId} {
      // Must be logged in and payload must be valid
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.type in ['feedback', 'bug'];
      allow read, update, delete: if false; 
    }
  }
}
