rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==================== USER RULES ====================
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ==================== EXPERIENCES RULES ====================
    match /experiences/{expId} {
      allow read: if true; 
      // Must be logged in and the payload userId must match their auth uid
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Only the author can update or delete
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ==================== QUESTIONS RULES ====================
    match /questions/{questionId} {
      allow read: if true;
      // Must be logged in to ask, and askerId must match their auth uid
      allow create: if request.auth != null && request.resource.data.askerId == request.auth.uid;
      // Allow the asker to update/delete their own question OR allow the experience author to reply to it
      allow update: if request.auth != null && (
        resource.data.askerId == request.auth.uid ||
        get(/databases/$(database)/documents/experiences/$(resource.data.experienceId)).data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.askerId == request.auth.uid;
    }

    // ==================== FEEDBACK RULES ====================
    match /feedback/{feedbackId} {
      // Anyone can submit feedback, but they can't read others' feedback
      allow create: if true;
      allow read, update, delete: if false; 
    }
  }
}
